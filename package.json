{
  "name": "static-browser",
  "productName": "Static",
  "version": "0.1.0",
  "description": "A Chromium-based desktop web browser built on Electron with real Chrome extension support.",
  "main": "src/main/main.js",
  "license": "GPL-3.0",
  "private": true,
  "author": "Sam",
  "scripts": {
    "build:preload": "node scripts/build-preload.js",
    "prestart": "npm run build:preload",
    "start": "electron .",
    "predist": "npm run build:preload",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "dependencies": {
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
