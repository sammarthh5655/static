{
  "name": "static",
  "productName": "static",
  "version": "0.1.0",
  "description": "static - a modular desktop browser with real Chromium tabs and Chrome extensions",
  "main": "src/main/main.js",
  "author": "sammarth025@gmail.com",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "prestart": "npm run build",
    "start": "node scripts/start.cjs",
    "dev": "npm start -- --dev",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "test:smoke": "npm run build && node scripts/start.cjs --smoke",
    "test:store": "npm run build && node scripts/start.cjs --smoke-store",
    "test:welcome": "npm run build && node scripts/start.cjs --welcome",
    "test:extract": "npm run build && node scripts/start.cjs --extract",
    "test:ads": "npm run build && node scripts/start.cjs --ytdeep",
    "test:aispeed": "npm run build && node scripts/start.cjs --aispeed",
    "test:adsites": "npm run build && node scripts/start.cjs --adsites",
    "test:lists": "npm run build && node scripts/start.cjs --lists",
    "test:stalecache": "npm run build && node scripts/start.cjs --stalecache",
    "test:menu": "npm run build && node scripts/start.cjs --menu",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:shot": "npm run build && node scripts/start.cjs --shot",
    "test:probe": "npm run build && node scripts/start.cjs --probe",
    "shortcut": "node scripts/shortcut.cjs",
    "test:appearance": "npm run build && node scripts/start.cjs --appearance",
    "test:ai": "npm run build && node scripts/start.cjs --ai",
    "test:aipage": "npm run build && node scripts/start.cjs --aipage",
    "test:modes": "npm run build && node scripts/start.cjs --modes",
    "test:homepage": "npm run build && node scripts/start.cjs --homepage",
    "check:security": "node scripts/security.cjs",
    "test:shields": "npm run build && node scripts/start.cjs --shields",
    "test:privacy": "npm run build && node scripts/start.cjs --privacy",
    "test:productivity": "npm run build && node scripts/start.cjs --productivity",
    "prepack": "npm run build",
    "dist:mac:arm": "npm run build && electron-builder --mac --arm64",
    "dist:mac:intel": "npm run build && electron-builder --mac --x64",
    "icon": "node -e \"const{spawn}=require('child_process');spawn(require('electron'),['scripts/make-icon.cjs'],{stdio:'inherit'})\""
  },
  "dependencies": {
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "dev.staticbrowser.desktop",
    "productName": "static",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "A website you visit may ask to use the camera. Static only allows it when you agree.",
        "NSMicrophoneUsageDescription": "A website you visit may ask to use the microphone. Static only allows it when you agree.",
        "NSLocationWhenInUseUsageDescription": "A website you visit may ask for your location. Static only shares it when you agree.",
        "NSDownloadsFolderUsageDescription": "Static saves files you download to your Downloads folder.",
        "NSDocumentsFolderUsageDescription": "Static can save pages and notes to a folder you choose.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ],
        "LSMinimumSystemVersion": "11.0"
      },
      "identity": null,
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "static contributors",
      "icon": "build/icon.png"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "dmg": {
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}